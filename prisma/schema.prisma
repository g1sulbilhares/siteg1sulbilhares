// Módulo de Custos — G1 Sul Bilhares
//
// Este schema é a fonte de verdade dos dados usados pelo motor de cálculo em
// `src/server/costs/`. Ele fica deliberadamente separado do catálogo público
// (`src/data/products.ts`): o catálogo é o que o cliente vê no site; este
// schema é o que a fábrica usa para saber quanto cada produto custa de
// verdade. A ideia é que, no futuro, o preço calculado aqui alimente o
// catálogo público — não o contrário.
//
// Convenção: todo valor monetário é armazenado em centavos (Int), igual ao
// `priceCents` que já existe em `src/data/products.ts`. Evita problemas de
// arredondamento com float e mantém os dois lados do projeto consistentes.
//
// Prisma 7: a connection string NÃO fica mais aqui (ver prisma.config.ts
// na raiz do projeto para o CLI, e src/lib/prisma.ts para o driver adapter
// usado em runtime).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Cadastro único de matéria-prima (Etapa 1 do módulo).
// Alterar unitPriceCents aqui recalcula automaticamente o custo de todo
// produto que usa este material — é o motor de cálculo em
// `src/server/costs/calculate-product-cost.ts` que lê este valor ao vivo.
// ---------------------------------------------------------------------------
model RawMaterial {
  id            String   @id @default(cuid())
  name          String
  category      String
  unit          UnitOfMeasure
  unitPriceCents Int
  supplier      String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usedIn ProductMaterial[]

  @@index([category])
  @@map("raw_materials")
}

enum UnitOfMeasure {
  UNIDADE
  METRO
  METRO_QUADRADO
  QUILOGRAMA
  LITRO
  PAR
  KIT

  @@map("unit_of_measure")
}

// ---------------------------------------------------------------------------
// Produto do ponto de vista de custo (não confundir com o catálogo público
// em src/data/products.ts). PRODUCAO_PROPRIA usa a Lista de Materiais (BOM)
// + mão de obra; REVENDA usa valor de compra + frete.
// ---------------------------------------------------------------------------
model Product {
  id       String      @id @default(cuid())
  code     String      @unique
  name     String
  category String
  type     ProductType

  // Produção própria: preenchido via ProductMaterial (BOM) + os três campos
  // de mão de obra abaixo.
  avgProductionMinutes Int?
  laborCostPerHourCents Int?
  workersCount          Int?

  // Revenda: preço de compra do fornecedor + frete até a loja.
  purchasePriceCents Int?
  freightCents       Int?

  sellingPriceCents Int
  active            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materials ProductMaterial[]
  snapshots CostSnapshot[]

  @@index([type])
  @@index([category])
  @@map("products")
}

enum ProductType {
  PRODUCAO_PROPRIA
  REVENDA

  @@map("product_type")
}

// ---------------------------------------------------------------------------
// Lista de Materiais (BOM): quanto de cada matéria-prima um produto de
// produção própria usa. Quantidade totalmente configurável por produto.
// ---------------------------------------------------------------------------
model ProductMaterial {
  id         String  @id @default(cuid())
  productId  String
  materialId String
  quantity   Decimal @db.Decimal(12, 4)

  product  Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  material RawMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([productId, materialId])
  @@map("product_materials")
}

// ---------------------------------------------------------------------------
// Custos indiretos (energia, aluguel, manutenção, etc.), rateados
// automaticamente pelo motor de cálculo usando os parâmetros em
// CostSettings — nenhum produto referencia isso diretamente.
// ---------------------------------------------------------------------------
model OverheadCost {
  id                String                  @id @default(cuid())
  name              String
  category          String
  monthlyAmountCents Int
  allocationMethod  OverheadAllocationMethod @default(PER_UNIT)
  active            Boolean                 @default(true)
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("overhead_costs")
}

enum OverheadAllocationMethod {
  PER_UNIT // dividido pela produção mensal estimada (CostSettings.estimatedMonthlyUnits)
  PER_LABOR_HOUR // dividido pelas horas de mão de obra mensais estimadas

  @@map("overhead_allocation_method")
}

// ---------------------------------------------------------------------------
// Parâmetros globais do rateio de indiretos. Registro único (singleton).
// ---------------------------------------------------------------------------
model CostSettings {
  id                        String  @id @default("singleton")
  estimatedMonthlyUnits     Int     @default(1)
  estimatedMonthlyLaborHours Int    @default(1)
  defaultMarkupPercent      Decimal @db.Decimal(6, 2) @default(0)
  updatedAt                 DateTime @updatedAt

  @@map("cost_settings")
}

// ---------------------------------------------------------------------------
// Histórico de cálculos (append-only) — alimenta "Evolução dos custos" no
// dashboard sem precisar reprocessar tudo a cada consulta.
// ---------------------------------------------------------------------------
model CostSnapshot {
  id                 String   @id @default(cuid())
  productId          String
  materialCostCents  Int
  laborCostCents     Int
  overheadCostCents  Int
  totalCostCents     Int
  sellingPriceCents  Int
  profitCents        Int
  marginPercent      Decimal  @db.Decimal(6, 2)
  markupPercent      Decimal  @db.Decimal(6, 2)
  computedAt         DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, computedAt])
  @@map("cost_snapshots")
}

// ---------------------------------------------------------------------------
// Membros da equipe com acesso à área interna (/custos). O login em si é
// feito pelo Supabase Auth; esta tabela só guarda o papel de cada usuário.
// ---------------------------------------------------------------------------
model TeamMember {
  id             String   @id @default(cuid())
  /// FK lógica para auth.users(id) do Supabase (tabela gerenciada pelo
  /// Supabase Auth, fora do schema do Prisma — por isso a referência é só
  /// documentada aqui, não modelada como relation).
  supabaseUserId String   @unique @db.Uuid
  name           String
  email          String   @unique
  role           TeamRole @default(GESTOR)
  createdAt      DateTime @default(now())

  @@map("team_members")
}

enum TeamRole {
  ADMIN
  GESTOR

  @@map("team_role")
}
